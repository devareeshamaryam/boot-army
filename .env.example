# Google Sheet ID (the long id in the spreadsheet URL). Required.
GOOGLE_SHEET_ID=
# Path to the Google service-account JSON key. Default: ./credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Slack incoming webhook for the daily message and FAILED alerts. One of these is required.
SLACK_WEBHOOK_URL=
# Optional: webhook for the "sponsors" channel only; overrides SLACK_WEBHOOK_URL.
SLACK_WEBHOOK_URL_SPONSORS=

# Optional: healthchecks.io base URL (e.g. https://hc-ping.com). Pings are skipped unless a check UUID is set too.
HEALTHCHECKS_BASE_URL=
# Optional: healthchecks.io check UUID for this job.
HC_UUID_SPONSOR_LICENCE_SCOUT=
# Optional: legacy name for the check UUID; wins over HC_UUID_SPONSOR_LICENCE_SCOUT if set.
SLS_HC_UUID=

# Optional: direct link to the register CSV, used only if GOV.UK discovery fails.
SPONSOR_CSV_URL=
# Optional: User-Agent for GOV.UK requests (default: a desktop browser UA).
SLS_USER_AGENT=
# Optional: contact (email or URL) appended to the default User-Agent for other requests.
BOTARMY_CONTACT=

# Optional: log level: debug, info, warn or error (default info).
LOG_LEVEL=
# Optional: log format: json or text (default json).
LOG_FORMAT=

# Testing only: record HTTP responses to this folder / replay them from it instead of the network.
BOTARMY_HTTP_RECORD=
BOTARMY_HTTP_REPLAY=
