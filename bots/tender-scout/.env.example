# TenderScout reads the ROOT .env (bot-army/.env). Names only — never commit values.

# Slack incoming webhooks, one per entity. The NAME is set per profile in profiles.json (slackWebhookEnv).
SLACK_WEBHOOK_URL_TENDERS_ATECA=
SLACK_WEBHOOK_URL_TENDERS_OSBROOKS=
SLACK_WEBHOOK_URL_TENDERS_AMC_BME=
SLACK_WEBHOOK_URL_TENDERS_TRADING_CO=

# Optional: healthchecks.io (same convention as the other bots). Skipped on dry runs.
HEALTHCHECKS_BASE_URL=
HC_UUID_TENDER_SCOUT=

# Optional: contact added to the User-Agent, e.g. an email or URL.
BOTARMY_CONTACT=

# Optional: LOG_FORMAT=text for readable logs while developing.
LOG_FORMAT=
